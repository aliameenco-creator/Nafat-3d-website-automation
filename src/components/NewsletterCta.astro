---
import { newsletter } from '../data/site';
---

<section class="section">
  <div class="wrap">
    <div class="cta">
      <p class="eyebrow">The newsletter</p>
      <h2>One short email a week on <em>new AI tools</em>.</h2>
      <p class="lead">{newsletter.name} is a quick weekly read: what's new, what's worth your time, and what to try. Free, and you can unsubscribe anytime.</p>
      <div class="btn-row">
        <a class="btn accent" href={newsletter.url} rel="noopener">Get the AI Brief</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 40px 24px;
    text-align: center;
  }
  .cta .lead {
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }
  .btn-row {
    justify-content: center;
  }
  @media (min-width: 720px) {
    .cta {
      padding: 72px 48px;
    }
  }
</style>
