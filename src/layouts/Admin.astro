---
import '../styles/global.css';
import '../styles/admin.css';
import { site } from '../data/site';

interface Props {
  title: string;
  // Full-bleed pages (the editor) manage their own width.
  bare?: boolean;
}

const { title, bare = false } = Astro.props;
const user = Astro.locals.user!;
const path = Astro.url.pathname;
const base = Astro.locals.admin;

const icons: Record<string, string> = {
  home: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
  posts: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  media: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/>',
  mcp: '<path d="m7 8-4 4 4 4M17 8l4 4-4 4M14 4l-4 16"/>',
  team: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6.5 6.5 0 0 1 3.5 6"/>',
  account: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  site: '<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  out: '<path d="M15 4h4a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-4M10 17l5-5-5-5M15 12H3"/>',
  resources: '<path d="M20 12v8a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-8M2 8h20v4H2zM12 21V8M12 8H7.5a2.5 2.5 0 1 1 0-5C11 3 12 8 12 8zM12 8h4.5a2.5 2.5 0 1 0 0-5C13 3 12 8 12 8z"/>',
  subscribers: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  emails: '<path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/>',
};

const links = [
  { href: `${base}/`, label: 'Overview', icon: 'home', exact: true },
  { href: `${base}/posts/`, label: 'Posts', icon: 'posts' },
  { href: `${base}/posts/new/`, label: 'New post', icon: 'plus', exact: true },
  { href: `${base}/resources/`, label: 'Resources', icon: 'resources' },
  { href: `${base}/subscribers/`, label: 'Subscribers', icon: 'subscribers' },
  { href: `${base}/emails/`, label: 'Emails', icon: 'emails' },
  { href: `${base}/media/`, label: 'Media', icon: 'media' },
  { href: `${base}/mcp/`, label: 'Claude / MCP', icon: 'mcp' },
  { href: `${base}/team/`, label: 'Team', icon: 'team' },
  { href: `${base}/account/`, label: 'Account', icon: 'account' },
];
const current = (l: (typeof links)[number]) =>
  l.exact ? path === l.href || path === l.href.slice(0, -1) : path.startsWith(l.href) && !path.startsWith(`${base}/posts/new`);
const initials = user.name
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Dashboard · {site.name}</title>
    <link rel="icon" href="/assets/nafay.jpg" />
    <meta name="theme-color" content="#f4f5fa" />
</head>
  <body class="admin" data-admin={base}>
    <div class="shell">
      <aside class="side">
        <a class="brand" href={`${base}/`}>{site.name}<small>Studio</small></a>
        <button type="button" class="menu-btn" aria-expanded="false" aria-controls="admin-nav">Menu</button>
        <nav id="admin-nav" aria-label="Dashboard">
            {
              links.map((l) => (
                <a href={l.href} aria-current={current(l) ? 'page' : undefined}>
                  <svg viewBox="0 0 24 24" set:html={icons[l.icon]} />
                  {l.label}
                </a>
              ))
            }
            <div class="sep"></div>
            <a href="/blog/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" set:html={icons.site} />View blog</a>
            <form method="post" action={`${base}/logout/`}>
              <button type="submit"><svg viewBox="0 0 24 24" set:html={icons.out} />Sign out</button>
            </form>
        </nav>
        <div class="who">
          <span class="avatar">{initials}</span>
          <div style="min-width:0">
            <div style="font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{user.name}</div>
            <div class="muted" style="font-size:0.78rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{user.email}</div>
          </div>
        </div>
      </aside>
      <main class="content">
        <div class={bare ? '' : 'page'}>
          <slot />
        </div>
      </main>
    </div>
    <div id="toast" role="status" aria-live="polite"></div>
    <script>
      const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
      menuBtn.addEventListener('click', () => {
        const open = menuBtn.getAttribute('aria-expanded') !== 'true';
        menuBtn.setAttribute('aria-expanded', String(open));
        menuBtn.closest('.side')!.classList.toggle('open', open);
      });
    </script>
  </body>
</html>
