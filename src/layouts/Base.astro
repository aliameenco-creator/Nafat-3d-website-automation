---
import { siteOrigin } from '../lib/origin';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, socials } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  // Extra JSON-LD objects for this page (FAQPage, Article, VideoObject...)
  schema?: Record<string, unknown>[];
  // Used as the <title> exactly as given, without the site-name suffix (blog meta titles).
  exactTitle?: string;
  imageAlt?: string;
  canonical?: string;
  noindex?: boolean;
  // Social overrides for blog posts.
  socialTitle?: string;
  socialDescription?: string;
  article?: { publishedTime: string; modifiedTime: string; tags: string[] };
}

const {
  title,
  description = site.description,
  image = '/assets/nafay.jpg',
  type = 'website',
  schema = [],
  exactTitle,
  imageAlt,
  noindex = false,
  article,
} = Astro.props;

const fullTitle = exactTitle ?? (title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`);
// Static pages use the address in astro.config. Pages rendered on request (the blog) use the domain they are
// served from, so links stay right on any domain the site is served from.
const siteUrl = siteOrigin(Astro.url);
const canonical = Astro.props.canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;
const socialTitle = Astro.props.socialTitle ?? fullTitle;
const socialDescription = Astro.props.socialDescription ?? description;
const xHandle = socials.find((s) => s.id === 'x')?.handle;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteUrl}/#person`,
  name: site.name,
  url: siteUrl,
  image: ogImage,
  jobTitle: site.jobTitle,
  description: site.description,
  sameAs: socials.map((s) => s.url),
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: site.name,
  url: siteUrl,
  publisher: { '@id': `${siteUrl}/#person` },
};
const graph = [person, website, ...schema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/nafay.jpg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Blog`} href="/rss.xml" />
    <meta name="theme-color" content="#f4f5fa" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedTime} />
          <meta property="article:modified_time" content={article.modifiedTime} />
          <meta property="article:author" content={siteUrl} />
          {article.tags.map((t) => <meta property="article:tag" content={t} />)}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    {xHandle && <meta name="twitter:site" content={xHandle} />}
    {xHandle && <meta name="twitter:creator" content={xHandle} />}
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={ogImage} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

    <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
    <slot name="head" />

</head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
