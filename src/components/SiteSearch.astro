---
// Search box for /search/, which looks through free resources and blog posts together.
interface Props {
  value?: string;
  placeholder?: string;
}
const { value = '', placeholder = 'Search posts and prompts, or paste a YouTube link' } = Astro.props;
---

<form class="find" action="/search/" method="get" role="search">
  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
  <input type="search" name="q" value={value} placeholder={placeholder} aria-label="Search" maxlength="200" />
  <button class="btn" type="submit">Search</button>
</form>

<style>
  .find {
    position: relative;
    display: flex;
    gap: 8px;
    margin-top: 28px;
    max-width: 620px;
  }
  svg {
    position: absolute;
    left: 16px;
    top: 50%;
    width: 18px;
    height: 18px;
    transform: translateY(-50%);
    stroke: var(--muted);
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    pointer-events: none;
  }
  input {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 1rem;
    color: var(--text);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 12px 16px 12px 44px;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .btn {
    cursor: pointer;
    font: inherit;
    font-weight: 600;
  }
  /* On phones the keyboard's Search key submits, so the field gets the full width. */
  @media (max-width: 480px) {
    .btn {
      display: none;
    }
  }
</style>
