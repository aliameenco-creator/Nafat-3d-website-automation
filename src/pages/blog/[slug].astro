---
import { siteOrigin } from '../../lib/origin';
import Base from '../../layouts/Base.astro';
import NewsletterCta from '../../components/NewsletterCta.astro';
import VideoModal from '../../components/VideoModal.astro';
import { site } from '../../data/site';
import { renderMarkdown, outline } from '../../lib/server/markdown';
import { getLivePost, plainText, readingMinutes, relatedPosts } from '../../lib/server/posts';
import { withResourceCards } from '../../lib/server/resources';

export const prerender = false;

const post = await getLivePost(Astro.params.slug!);
if (!post) return new Response(null, { status: 404, statusText: 'Not found' });

// Rendered at the edge on each visit, so edits are live immediately.
Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');

// Free resources linked in the post, or made from its video, appear as sign-up cards.
const html = await withResourceCards(renderMarkdown(post.content), { page: `/blog/${post.slug}/` });
const toc = outline(post.content);
const related = await relatedPosts(post);
const minutes = readingMinutes(post.content);
const base = siteOrigin(Astro.url);
const url = new URL(`/blog/${post.slug}/`, base).href;
const description = post.metaDescription || post.excerpt || plainText(post.content);
const image = post.ogImage || post.coverImage || '/og.jpg';
const published = new Date(post.publishedAt!);
const modified = new Date(Math.max(post.updatedAt, post.publishedAt!));
const showUpdated = modified.getTime() - published.getTime() > 86_400_000;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: post.title,
    description,
    image: [new URL(image, base).href],
    datePublished: published.toISOString(),
    dateModified: modified.toISOString(),
    author: { '@id': `${base}/#person` },
    publisher: { '@id': `${base}/#person` },
    mainEntityOfPage: post.canonicalUrl || url,
    isPartOf: { '@id': `${base}/blog/#blog` },
    keywords: post.tags.join(', ') || undefined,
    wordCount: post.content.split(/\s+/).filter(Boolean).length,
    timeRequired: `PT${minutes}M`,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${base}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${base}/blog/` },
      { '@type': 'ListItem', position: 3, name: post.title, item: url },
    ],
  },
];

const shareText = encodeURIComponent(post.ogTitle || post.title);
const shareUrl = encodeURIComponent(url);
const shares = [
  { label: 'X', href: `https://x.com/intent/post?text=${shareText}&url=${shareUrl}`, icon: '<path d="M4 4l16 16M20 4L4 20" />' },
  { label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`, icon: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/>' },
  { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`, icon: '<path d="M15 3h-2a4 4 0 0 0-4 4v3H6v4h3v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h2z"/>' },
  { label: 'WhatsApp', href: `https://wa.me/?text=${shareText}%20${shareUrl}`, icon: '<path d="M3 21l1.6-4.8A8.5 8.5 0 1 1 8 19.6z"/>' },
];
---

<Base
  title={post.title}
  exactTitle={post.metaTitle || undefined}
  description={description}
  socialTitle={post.ogTitle || post.metaTitle || undefined}
  socialDescription={post.ogDescription || undefined}
  image={image}
  imageAlt={post.coverAlt || undefined}
  type="article"
  canonical={post.canonicalUrl || url}
  noindex={post.noindex}
  article={{ publishedTime: published.toISOString(), modifiedTime: modified.toISOString(), tags: post.tags }}
  schema={schema}
>
  <article class="section post">
    <div class="wrap narrow">
      <nav class="crumbs eyebrow" aria-label="Breadcrumb"><a href="/blog/">Blog</a></nav>
      <h1>{post.title}</h1>
      {post.excerpt && <p class="lead muted">{post.excerpt}</p>}
      <p class="byline muted">
        <span>By <a href="/about/">{site.name}</a></span>
        <span>·</span>
        <time datetime={published.toISOString()}>{fmt(published)}</time>
        <span>·</span>
        <span>{minutes} min read</span>
        {
          showUpdated && (
            <>
              <span>·</span>
              <span>
                Updated <time datetime={modified.toISOString()}>{fmt(modified)}</time>
              </span>
            </>
          )
        }
      </p>
    </div>

    {
      post.coverImage && (
        <div class="wrap cover-wrap">
          <div class="photo cover">
            <img src={post.coverImage} alt={post.coverAlt ?? ''} fetchpriority="high" decoding="async" />
          </div>
        </div>
      )
    }

    <div class="wrap narrow">
      {
        toc.length >= 3 && (
          <details class="toc">
            <summary>On this page</summary>
            <ol>
              {toc.map((h) => (
                <li class={h.depth === 3 ? 'sub' : ''}>
                  <a href={`#${h.id}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )
      }

      <div class="prose" set:html={html} />

      {
        post.tags.length > 0 && (
          <div class="tags">
            {post.tags.map((t) => (
              <a href={`/blog/tag/${encodeURIComponent(t.toLowerCase())}/`}>#{t}</a>
            ))}
          </div>
        )
      }

      <div class="share">
        <span class="eyebrow" style="margin:0">Share</span>
        {
          shares.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={`Share on ${s.label}`} title={s.label}>
              <svg viewBox="0 0 24 24" set:html={s.icon} />
            </a>
          ))
        }
        <button type="button" class="copy" data-url={url} aria-label="Copy link" title="Copy link">
          <svg viewBox="0 0 24 24"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"></path></svg>
          <span>Copy link</span>
        </button>
      </div>

      {
        related.length > 0 && (
          <aside class="related">
            <p class="eyebrow">Keep reading</p>
            <ul>
              {related.map((r) => (
                <li>
                  <a href={`/blog/${r.slug}/`}>
                    <span class="r-title">{r.title}</span>
                    <span class="muted">{readingMinutes(r.content)} min read</span>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </article>
  <NewsletterCta />
  <VideoModal />
</Base>

<script is:inline define:vars={{ slug: post.slug }}>
  try {
    navigator.sendBeacon('/api/view', slug);
  } catch (e) {}
</script>

<script>
  import '../../scripts/gate';
  import '../../scripts/video';
  import '../../scripts/copy-code';

  const btn = document.querySelector<HTMLButtonElement>('.copy');
  btn?.addEventListener('click', async () => {
    const url = btn.dataset.url!;
    if (navigator.share && matchMedia('(pointer: coarse)').matches) {
      navigator.share({ title: document.title, url }).catch(() => {});
      return;
    }
    await navigator.clipboard.writeText(url).catch(() => {});
    btn.querySelector('span')!.textContent = 'Copied';
    setTimeout(() => (btn.querySelector('span')!.textContent = 'Copy link'), 1800);
  });
</script>

<style>
  .post {
    padding-bottom: 48px;
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a::before {
    content: '← ';
  }
  .crumbs a:hover {
    color: var(--text);
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.9rem;
    margin: 20px 0 0;
  }
  .byline a {
    text-decoration: none;
    color: var(--text);
  }
  .cover-wrap {
    max-width: 920px;
    margin-top: 36px;
  }
  .cover {
    aspect-ratio: 1200 / 630;
  }
  .toc {
    margin: 36px 0 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 14px 18px;
    font-size: 0.95rem;
  }
  .toc summary {
    cursor: pointer;
    font-weight: 600;
  }
  .toc ol {
    margin: 10px 0 0;
    padding-left: 20px;
  }
  .toc li {
    padding: 3px 0;
  }
  .toc li.sub {
    margin-left: 16px;
    list-style: circle;
  }
  .toc a {
    text-decoration: none;
    color: var(--muted);
  }
  .toc a:hover {
    color: var(--text);
  }
  .prose {
    margin-top: 40px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 40px;
  }
  .tags a {
    font-size: 0.88rem;
    color: var(--muted);
    text-decoration: none;
  }
  .tags a:hover {
    color: var(--accent-ink);
  }
  .share {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .share .eyebrow {
    margin-right: 8px;
  }
  .share a,
  .share button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    min-width: 38px;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    color: var(--text);
    cursor: pointer;
    font: inherit;
    font-size: 0.88rem;
    transition: border-color 0.15s;
  }
  .share button {
    padding: 0 14px;
  }
  .share a:hover,
  .share button:hover {
    border-color: var(--muted);
  }
  .share svg {
    width: 17px;
    height: 17px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .related {
    margin-top: 48px;
  }
  .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .related li + li {
    border-top: 1px solid var(--line);
  }
  .related a {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    text-decoration: none;
  }
  .r-title {
    font-family: var(--serif);
    font-size: 1.35rem;
    line-height: 1.2;
  }
  .related a:hover .r-title {
    color: var(--accent-ink);
  }
  .related .muted {
    white-space: nowrap;
    font-size: 0.85rem;
  }
</style>
