# Copy to .env for local use (npm run dev reads it). On Hostinger, add the same names under
# your Node.js app -> Environment variables instead. Never commit the real .env.

# Creates the first dashboard admin the first time you sign in. Ignored once an admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# The secret dashboard address, e.g. 7c1e8a-86c7b7-bd2ff1 (the dashboard is then at /7c1e8a-86c7b7-bd2ff1/).
# Without it the dashboard stays at /admin. Use letters, digits and dashes.
ADMIN_PATH=

# Where the SQLite database file lives. On Hostinger use a folder OUTSIDE the app folder,
# e.g. /home/<user>/nafay-data/nafay.sqlite, so redeploys never touch it.
DB_PATH=./data/nafay.sqlite

# Email through Resend (see README -> Email). Both are needed to send.
RESEND_API_KEY=
EMAIL_FROM=

# Resource sign-ups are also copied into the Kit form on the homepage (id is set in src/data/site.ts).
# Set to "off" on your own computer so test sign-ups never reach the real newsletter, or to another form id.
KIT_FORM_ID=off

# Optional: an n8n / Zapier / Make webhook that receives every sign-up and unsubscribe.
LEADS_WEBHOOK_URL=
