---
// One free resource in a grid: thumbnail (the video's when there is no cover), type, date and title.
import { coverOf, kindLabel, resourcePath, type Resource } from '../lib/server/resources';

interface Props {
  r: Resource;
}
const { r } = Astro.props;
const img = coverOf(r);
const date = r.publishedAt ? new Date(r.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
---

<a class="rcard" href={resourcePath(r.slug)}>
  <div class="media">
    {img ? <img src={img} alt="" loading="lazy" decoding="async" /> : <span class="placeholder" aria-hidden="true">{r.title[0]}</span>}
    <span class="free">Free</span>
  </div>
  <p class="meta"><span class="kind">{kindLabel(r.kind)}</span>{date}</p>
  <h3>{r.title}</h3>
  {r.summary && <p class="excerpt">{r.summary}</p>}
</a>

<style>
  .rcard {
    display: block;
    text-decoration: none;
  }
  .media {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    margin-bottom: 14px;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .rcard:hover .media img {
    transform: scale(1.03);
  }
  .placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-family: var(--serif);
    font-size: 4rem;
    color: var(--accent-ink);
    background:
      radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 60%),
      var(--bg-soft);
  }
  .free {
    position: absolute;
    left: 10px;
    top: 10px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-text);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0 0 8px;
  }
  .kind {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  h3 {
    font-size: 1.4rem;
    line-height: 1.2;
    margin: 0 0 8px;
    transition: color 0.15s;
  }
  .rcard:hover h3 {
    color: var(--accent-ink);
  }
  .excerpt {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
